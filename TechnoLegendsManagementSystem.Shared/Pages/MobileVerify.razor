@page "/mobile-verify"
@layout MobileAuthLayout
@attribute [AllowAnonymous]
@inject IJSRuntime JS

<div class="auth-card">
    <div class="row between mb">
        <button class="muted sm" @onclick="GoBack"><i class="bi bi-arrow-left"></i> Back to sign in</button>
        <span class="chip"><i class="bi bi-shield-check"></i> TLMS Auth v2.4</span>
    </div>

    <div class="center">
        <div class="brand-icon"><i class="bi bi-terminal"></i></div>
        <h3>Verify your account</h3>
        <p class="muted xs" style="margin:4px 0">Enter the 6-digit code from your authenticator app</p>
        <p class="xs muted" style="margin:4px 0">Code sent to <strong>@Email</strong></p>
    </div>

    <div class="row between mt">
        <span class="xs bold muted">AUTHENTICATOR CODE</span>
        <span class="xs bold" style="color:var(--blue)"><i class="bi bi-arrow-repeat"></i> Refreshes every 30s</span>
    </div>

    <div class="passcode">
        @for (var i = 0; i < 6; i++)
        {
            <div class="pbox @(i == passcode.Length ? "active" : "")">
                @if (i < passcode.Length)
                {
                    @passcode[i]
                }
                else if (i == passcode.Length)
                {
                    <span style="color:var(--blue)">|</span>
                }
                else
                {
                    <span class="muted" style="opacity:.3">&bull;</span>
                }
            </div>
        }
    </div>

    @if (error is not null)
    {
        <div class="error">@error</div>
    }

    <button class="btn btn-primary" @onclick="VerifyCodeAsync" disabled="@(IsVerifying || passcode.Length < 6)">
        <i class="bi bi-check-circle"></i> @(IsVerifying ? "Verifying..." : "Verify & Proceed")
    </button>

    <div style="border-top:1px solid var(--line);padding-top:12px;margin-top:14px">
        <div class="row between mb">
            <span class="xs bold muted"><i class="bi bi-grid-3x3-gap-fill"></i> Quick Dial Keypad</span>
            <span class="chip green">&bull; Live Encrypted</span>
        </div>
        <div class="keypad">
            @foreach (var (n, letters) in keys)
            {
                <button class="key" @onclick="() => AppendDigit(n)"><b>@n</b><small>@((MarkupString)(letters == "" ? "&nbsp;" : letters))</small></button>
            }
            <button class="key" @onclick="PasteCode"><small class="bold" style="color:var(--text)"><i class="bi bi-clipboard"></i> Paste</small></button>
            <button class="key" @onclick='() => AppendDigit("0")'><b>0</b><small>&nbsp;</small></button>
            <button class="key" @onclick="DeleteLastDigit"><small class="bold" style="color:var(--text)"><i class="bi bi-backspace"></i> Del</small></button>
        </div>
    </div>

    <div class="info-banner info-blue mt">
        <div class="row between">
            <span class="bold" style="color:var(--text)"><i class="bi bi-shield-lock"></i> Authorized Department Access</span>
            <span class="chip dark">SOC 2 Compliant</span>
        </div>
        <div style="margin-top:4px">Protected session monitored by Techno Legends Identity Security. If you did not initiate this request, notify your IT administrator immediately.</div>
    </div>
</div>

@code {
    private static readonly (string, string)[] keys =
    {
        ("1", ""), ("2", "ABC"), ("3", "DEF"), ("4", "GHI"), ("5", "JKL"),
        ("6", "MNO"), ("7", "PQRS"), ("8", "TUV"), ("9", "WXYZ")
    };

    [Inject] private SupabaseAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private string passcode = "";
    private bool IsVerifying { get; set; }
    private int Countdown { get; set; } = 42;
    private string? FactorId { get; set; }
    private string Email { get; set; } = "";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Email = AuthService.CurrentSession?.User?.Email ?? "";
        var factors = await AuthService.ListFactorsAsync();
        FactorId = factors?.FirstOrDefault()?.Id;
    }

    private void AppendDigit(string digit)
    {
        if (passcode.Length < 6) passcode += digit;
    }

    private void DeleteLastDigit()
    {
        if (passcode.Length > 0) passcode = passcode[..^1];
    }

    private async Task PasteCode()
    {
        try
        {
            var text = await JS.InvokeAsync<string>("navigator.clipboard.readText");
            passcode = new string((text ?? "").Where(char.IsDigit).Take(6).ToArray());
        }
        catch { error = "Couldn't read the clipboard."; }
    }

    private async Task VerifyCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(FactorId)) { error = "No TOTP factor enrolled."; return; }
        IsVerifying = true; error = null;
        try
        {
            await AuthService.ChallengeAndVerifyMfaAsync(FactorId, passcode);
            if (AuthProvider is SupabaseAuthStateProvider sp) sp.NotifyAuthenticationChanged();
            Nav.NavigateTo("/");
        }
        catch (Exception ex) { error = ex.Message; }
        finally { IsVerifying = false; }
    }

    private Task ResendCodeAsync() => Task.CompletedTask;
    private void GoBack() => Nav.NavigateTo("/mobile-login");
}