@page "/app-demos"

<div class="page-header">
    <h1 class="page-header__title">App Demos Gallery</h1>
    <div class="spacer"></div>
    <button class="btn btn-primary">+ Upload Demo</button>
</div>

<div class="row-sm" style="margin-bottom: 1.5rem; gap: 1rem;">
    <button class="btn btn-secondary active">All Departments (14)</button>
    <button class="btn btn-ghost">Development</button>
    <button class="btn btn-ghost">Design</button>
    <button class="btn btn-ghost">Management</button>
</div>

<div class="demo-grid">
    <!-- Demo Card 1 -->
    <div class="demo-card">
        <div class="demo-card__preview" style="background: linear-gradient(to right, #0f172a, #1e293b);">
            <span class="badge" style="position: absolute; top: 10px; left: 10px;">#DEVELOPMENT</span>
            <span class="badge badge--done" style="position: absolute; top: 10px; right: 10px;">v4.8.2</span>
            <h2 style="color: white; margin: 0;">Zero-Trust Enclave Gate</h2>
        </div>
        <div class="demo-card__body">
            <h3 style="margin-bottom: 0.5rem;">Zero-Trust Enclave Gate</h3>
            <p class="text-muted" style="font-size: 0.85rem;">Interactive cryptographic token exchange and biometric SSO sandbox.</p>
        </div>
        <div class="demo-card__footer">
            <span class="text-faint" style="font-size: 0.75rem;">🕒 14m ago</span>
            <button class="btn btn-primary btn-sm">View Demo ↗</button>
        </div>
    </div>

    <!-- Demo Card 2 -->
    <div class="demo-card">
        <div class="demo-card__preview" style="background: linear-gradient(to right, #1e293b, #0f172a);">
            <span class="badge" style="position: absolute; top: 10px; left: 10px;">#MANAGEMENT</span>
            <span class="badge badge--done" style="position: absolute; top: 10px; right: 10px;">v3.6.0</span>
            <h2 style="color: white; margin: 0;">Smart Attendance Portal</h2>
        </div>
        <div class="demo-card__body">
            <h3 style="margin-bottom: 0.5rem;">Smart Attendance Portal</h3>
            <p class="text-muted" style="font-size: 0.85rem;">Real-time meeting check-ins, dynamic QR rotation, and quorum audit exports.</p>
        </div>
        <div class="demo-card__footer">
            <span class="text-faint" style="font-size: 0.75rem;">🕒 2h ago</span>
            <button class="btn btn-primary btn-sm">View Demo ↗</button>
        </div>
    </div>
</div>