@page "/tasks/new"  
@attribute [Authorize]
@layout StackLayout
@inject ITaskService Svc
@inject NavigationManager Nav

<div class="row between" style="align-items:flex-start;margin-bottom:12px">
    <div>
        <h1 class="h2">Assign Task</h1>
        <div class="xs muted">Techno Legends Workspace &bull; Sprint 42</div>
    </div>
    <span class="chip"><i class="bi bi-circle-fill" style="font-size:.4rem"></i> Active Sprint</span>
</div>

@if (error is not null)
{
    <div class="error">@error</div>
}

<div class="card">
    <div class="row between" style="margin-bottom:6px">
        <label class="xs bold muted">Task Title <span class="danger">*</span></label>
        <span class="xs muted">@title.Length/200</span>
    </div>
    <input class="control" maxlength="200" @bind="title" @bind:event="oninput" placeholder="e.g., Implement OAuth2 PKCE Flow for Mobile" />
</div>

<div class="card">
    <label class="xs bold muted">Linked Project / Epic</label>
    <select class="control" style="margin-top:6px" @bind="project">
        @foreach (var p in lookups.Projects)
        {
            <option value="@p">@p</option>
        }
    </select>
</div>

<div class="card">
    <div class="row between mb">
        <label class="xs bold muted">Assignee Selection <span class="danger">*</span></label>
        <span class="xs bold" style="color:var(--blue)">@selected.Count Selected</span>
    </div>
    <div class="seg mb">
        <button class="@(memberTab ? "on" : "")" @onclick="() => memberTab = true"><i class="bi bi-person"></i> Member</button>
        <button class="@(!memberTab ? "on" : "")" @onclick="() => memberTab = false"><i class="bi bi-people"></i> Team / Guild</button>
    </div>

    @if (memberTab)
    {
        @foreach (var m in lookups.Members)
        {
            <button type="button" class="sel-row @(selected.Contains(m.Name) ? "on" : "")" @onclick="() => Toggle(m.Name)">
                <div class="avatar">@m.Initials</div>
                <div class="grow">
                    <div class="sm bold">@m.Name</div>
                    <div class="xs muted">@m.Title</div>
                </div>
                @if (selected.Contains(m.Name))
                {
                    <i class="bi bi-check-circle-fill" style="color:var(--blue)"></i>
                }
            </button>
        }
    }
    else
    {
        @foreach (var t in lookups.Teams)
        {
            <button type="button" class="sel-row @(selected.Contains(t) ? "on" : "")" @onclick="() => Toggle(t)">
                <div class="avatar"><i class="bi bi-people"></i></div>
                <div class="grow sm bold">@t</div>
                @if (selected.Contains(t))
                {
                    <i class="bi bi-check-circle-fill" style="color:var(--blue)"></i>
                }
            </button>
        }
    }
</div>

<div class="card">
    <div class="row between mb">
        <label class="xs bold muted">Priority Level</label>
        @if (priority == TaskPriority.High)
        {
            <span class="xs bold danger"><i class="bi bi-circle-fill" style="font-size:.4rem"></i> Critical Sprint Scope</span>
        }
    </div>
    <div class="opt-row">
        @foreach (var p in Enum.GetValues<TaskPriority>())
        {
            <button type="button" class="@(priority == p ? "on" : "") @p.ToString().ToLower()" @onclick="() => priority = p">@p</button>
        }
    </div>
</div>

<div class="card">
    <label class="xs bold muted">Due Date &amp; Target</label>
    <input type="date" class="control" style="margin:6px 0 10px" @bind="due" />
    <div class="chips">
        <button type="button" class="fchip" @onclick="() => due = DateTime.Today.AddDays(1)">Tomorrow</button>
        <button type="button" class="fchip" @onclick="() => due = lookups.SprintEnd">Sprint End (@lookups.SprintEnd.ToString("MMM dd"))</button>
    </div>
</div>

<div class="card">
    <div class="row between mb">
        <label class="xs bold muted">Effort Estimation</label>
        <span class="xs muted">Fibonacci Story Points</span>
    </div>
    <div class="opt-row">
        @foreach (var p in pointOptions)
        {
            <button type="button" class="@(points == p ? "on" : "")" @onclick="() => points = p">@p pt@(p > 1 ? "s" : "")</button>
        }
    </div>
</div>

<div class="card">
    <div class="row between mb">
        <label class="xs bold muted">Description &amp; Acceptance Criteria</label>
        <span class="xs muted">Markdown</span>
    </div>
    <div class="toolbar"><i class="bi bi-type-bold"></i><i class="bi bi-type-italic"></i><i class="bi bi-code"></i><i class="bi bi-list-ul"></i><i class="bi bi-paperclip"></i></div>
    <textarea class="control" @bind="description" @bind:event="oninput" placeholder="Provide technical scope, acceptance criteria, or context for the assignee..."></textarea>
</div>

<button class="btn btn-primary" disabled="@busy" @onclick="() => Submit(false)">
    <i class="bi bi-check2-square"></i> @(busy ? "Assigning..." : "Assign Task")
</button>
<button class="btn xs muted" style="margin:6px 0 16px" disabled="@busy" @onclick="() => Submit(true)">
    <i class="bi bi-file-earmark"></i> Save as Draft
</button>

@code {
    private static readonly int[] pointOptions = { 1, 2, 3, 5, 8 };

    private AssignLookups lookups = new(new(), new(), new(), DateTime.Today);
    private HashSet<string> selected = new();
    private string title = "", project = "", description = "";
    private string? error;
    private TaskPriority priority = TaskPriority.High;
    private DateTime due = DateTime.Today.AddDays(1);
    private int points = 5;
    private bool memberTab = true, busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lookups = await Svc.GetLookupsAsync();
            project = lookups.Projects.FirstOrDefault() ?? "";
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (Exception)
        {
            error = "Couldn't load projects and members. Try again.";
        }
    }

    private void Toggle(string name)
    {
        if (!selected.Add(name)) selected.Remove(name);
    }

    private async Task Submit(bool draft)
    {
        error = null;
        if (string.IsNullOrWhiteSpace(title)) { error = "Task title is required."; return; }
        if (!draft && selected.Count == 0) { error = "Select at least one assignee."; return; }
        if (string.IsNullOrWhiteSpace(project)) { error = "Pick a project. If the list is empty, the projects failed to load."; return; }

        busy = true;
        try
        {
            await Svc.CreateTaskAsync(new NewTask(title.Trim(), project, selected.ToList(), priority, due, points, description, draft));
            Nav.NavigateTo("/tasks");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (Exception)
        {
            error = "Couldn't save the task. Try again.";
        }
        finally
        {
            busy = false;
        }
    }
}