@page "/mobile-login"
@layout EmptyLayout
@attribute [AllowAnonymous]

<div class="mobile-login-container">
    <div class="mobile-brand">
        <div class="logo-box"><span>TLMS</span></div>
        <h2>Techno Legends</h2>
        <p>Organization Management System • Member Sign In</p>
    </div>

    <div class="mobile-login-card">
        <EditForm Model="Model" OnValidSubmit="HandleLoginAsync">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label>Email address</label>
                <div class="input-icon-wrapper">
                    <span class="input-icon">📧</span>
                    <InputText @bind-Value="Model.Email" class="form-control with-icon" placeholder="name@technolegends.org" />
                </div>
                <ValidationMessage For="@(() => Model.Email)" />
            </div>
            <div class="form-group">
                <div class="label-row"><label>Password</label><a href="#" class="forgot-link">Forgot password?</a></div>
                <div class="input-icon-wrapper">
                    <span class="input-icon">🔒</span>
                    <InputText @bind-Value="Model.Password" type="password" class="form-control with-icon" placeholder="Enter your password" />
                </div>
                <ValidationMessage For="@(() => Model.Password)" />
            </div>
            <button type="submit" class="btn btn-primary btn-block" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {

                    <span>→ Log in</span>
                }
            </button>
        </EditForm>

        <button class="btn btn-outline-secondary btn-block passkey-btn" @onclick="HandlePasskeyLoginAsync">
            🔑 Sign in with Passkey / Face ID
        </button>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3">@ErrorMessage</div>
        }
    </div>

    <div class="directory-gateway-info">
        <div class="gateway-header"><span>🛡</span><strong>Authorized Directory Gateway</strong></div>
        <p>Access for 5 departments: Upper Management, BA, Design, Dev, Marketing.</p>
    </div>

    <div class="mobile-footer">
        <span>IT Support Desk • Security Policy</span>
        <small>Techno Legends Inc. © 2025</small>
    </div>
</div>

@code {
    [Inject] private SupabaseAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private LoginModel Model { get; set; } = new();
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleLoginAsync()
    {
        IsLoading = true; ErrorMessage = null;
        try
        {
            var session = await AuthService.SignInAsync(Model.Email, Model.Password);
            if (session?.User == null) { ErrorMessage = "Invalid credentials."; return; }

            if (AuthProvider is SupabaseAuthStateProvider sp) sp.NotifyAuthenticationChanged();

            var aal = session.AccessToken?.Contains("\"aal\":\"aal2\"") == true ? "aal2" : "aal1";
            Nav.NavigateTo(aal == "aal2" ? "/" : "/mobile-verify");
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private Task HandlePasskeyLoginAsync() => Task.CompletedTask;

    public class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required, MinLength(8)] public string Password { get; set; } = string.Empty;
    }
}