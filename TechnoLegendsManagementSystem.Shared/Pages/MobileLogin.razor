@page "/mobile-login"
@layout MobileAuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations

<div class="auth-card">
    <div class="center mb">
        <div class="brand-icon"><i class="bi bi-terminal"></i></div>
        <h3>Techno Legends</h3>
        <p class="muted xs" style="margin-top:4px">Organization Management System &bull; Member Sign In</p>
    </div>

    <EditForm Model="Model" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error">@ErrorMessage</div>
        }

        <div class="field">
            <label>Email address</label>
            <div class="input-wrap">
                <i class="bi bi-envelope"></i>
                <InputText @bind-Value="Model.Email" placeholder="name@technolegends.org" />
            </div>
            <ValidationMessage For="@(() => Model.Email)" />
        </div>

        <div class="field">
            <div class="row between">
                <label>Password</label>
                <a href="javascript:void(0)" class="xs bold">Forgot password?</a>
            </div>
            <div class="input-wrap">
                <i class="bi bi-lock"></i>
                <InputText @bind-Value="Model.Password" type="@(show ? "text" : "password")" placeholder="Enter your password" />
                <button type="button" class="toggle" @onclick="() => show = !show">@(show ? "Hide" : "Show")</button>
            </div>
            <ValidationMessage For="@(() => Model.Password)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsLoading">
            <i class="bi bi-box-arrow-in-right"></i> @(IsLoading ? "Signing in..." : "Log in")
        </button>

        <button type="button" class="btn btn-outline mt" @onclick="HandlePasskeyLoginAsync">
            <i class="bi bi-fingerprint"></i> Sign in with Passkey / Face ID
        </button>
    </EditForm>

    <div class="info-banner mt">
        <div class="bold" style="color:var(--text)"><i class="bi bi-shield-check"></i> Authorized Directory Gateway</div>
        Access for 5 departments: Upper Management, BA, Design, Dev, Marketing.
    </div>

    <div class="center xs muted mt">
        IT Support Desk &bull; Security Policy
        <div>Techno Legends Inc. &copy; 2025</div>
    </div>
</div>

@code {
    [Inject] private SupabaseAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private LoginModel Model { get; set; } = new();
    private bool IsLoading { get; set; }
    private bool show;
    private string? ErrorMessage { get; set; }

    private async Task HandleLoginAsync()
    {
        IsLoading = true; ErrorMessage = null;
        try
        {
            var session = await AuthService.SignInAsync(Model.Email, Model.Password);
            if (session?.User == null) { ErrorMessage = "Invalid credentials."; return; }

            if (AuthProvider is SupabaseAuthStateProvider sp) sp.NotifyAuthenticationChanged();

            var aal = session.AccessToken?.Contains("\"aal\":\"aal2\"") == true ? "aal2" : "aal1";
            Nav.NavigateTo(aal == "aal2" ? "/" : "/mobile-verify");
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private Task HandlePasskeyLoginAsync() => Task.CompletedTask;

    public class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required, MinLength(8)] public string Password { get; set; } = string.Empty;
    }
}