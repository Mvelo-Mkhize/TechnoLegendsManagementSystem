    <div class="spacer"></div>
    <button class="btn btn-secondary">Audit Config</button>
    <button class="btn btn-primary">Export Log</button>
</div>

<div class="audit-stats">
    <div class="audit-stat-box">
        <span class="text-muted" style="font-size: 0.75rem; font-weight: 600;">24h EVENT VOLUME</span>
        <h2>1,428 <small style="font-size: 0.85rem; color: var(--tl-success);">+4.8%</small></h2>
        <span class="text-muted" style="font-size: 0.8rem;">Events</span>
    </div>
    <div class="audit-stat-box">
        <span class="text-muted" style="font-size: 0.75rem; font-weight: 600;">AUTHORIZATION RATE</span>
        <h2>99.2%</h2>
        <span class="text-muted" style="font-size: 0.8rem;">Success</span>
    </div>
    <div class="audit-stat-box">
        <span class="text-muted" style="font-size: 0.75rem; font-weight: 600;">BLOCKED ANOMALIES</span>
        <h2 style="color: var(--tl-danger);">14</h2>
        <span class="text-muted" style="font-size: 0.8rem;">Isolated</span>
    </div>
    <div class="audit-stat-box">
        <span class="text-muted" style="font-size: 0.75rem; font-weight: 600;">LEDGER INTEGRITY</span>
        <h2>100%</h2>
        <span class="text-muted" style="font-size: 0.8rem;">Synced</span>
    </div>
</div>

