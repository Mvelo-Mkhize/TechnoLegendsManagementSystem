@inherits LayoutComponentBase
@using System.Security.Claims

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="main">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar__title">Workspace</div>
            <div class="topbar__spacer"></div>

            <AuthorizeView>
                <Authorized>
                    <div class="row-sm">
                        <span class="text-muted" style="font-size: 0.9rem;">
                            @context.User.FindFirst(ClaimTypes.Email)?.Value
                        </span>
                        <!-- Use the avatar style for the user -->
                        <div class="avatar avatar-sm">
                            @(context.User.FindFirst(ClaimTypes.Email)?.Value?.Substring(0, 1).ToUpper())
                        </div>
                        <button class="btn btn-ghost btn-sm" @onclick="SignOutAsync">Sign Out</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <!-- Main Content Area -->
        <article class="content">
            @Body
        </article>
    </div>
</div>

@code {
    [Inject] private SupabaseAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private async Task SignOutAsync()
    {
        await AuthService.SignOutAsync();
        if (AuthProvider is SupabaseAuthStateProvider sp) sp.NotifyAuthenticationChanged();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}