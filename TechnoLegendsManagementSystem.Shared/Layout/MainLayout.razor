@inherits LayoutComponentBase
@using System.Security.Claims

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="user-email">
                        @context.User.FindFirst(ClaimTypes.Email)?.Value
                    </span>
                    <button class="btn btn-link" @onclick="SignOutAsync">Sign Out</button>
                </Authorized>
            </AuthorizeView>
        </div>
        <article class="content px-4">@Body</article>
    </main>
</div>

@code {
    [Inject] private SupabaseAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private async Task SignOutAsync()
    {
        await AuthService.SignOutAsync();
        if (AuthProvider is SupabaseAuthStateProvider sp) sp.NotifyAuthenticationChanged();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}